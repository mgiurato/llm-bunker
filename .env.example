# Copy this file to .env and uncomment one line to pick which GGUF
# bunker loads. .env itself is gitignored (local machine state); this
# example file is the tracked reference for what's available.
#
# Usage:
#   cp .env.example .env
#   # edit .env, pick one MODEL_FILE line
#   docker compose up -d --force-recreate bunker
#
# Or set it inline for a one-off run, no .env file needed:
#   MODEL_FILE=Hermes-3-Llama-3.1-8B.Q4_K_M.gguf docker compose up -d --force-recreate bunker
#
# See docs/models.md for details, checksums, and source links for each.

# MODEL_FILE=MiniCPM-V-4_6-Q4_K_M.gguf                    # default — vision-language, text-only mode, weak at agentic tool use
# MODEL_FILE=Hermes-3-Llama-3.1-8B.Q4_K_M.gguf             # fine-tuned for agentic tool use / function calling
# MODEL_FILE=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf         # coding-focused, strong tool use
# MODEL_FILE=llama-3.2-3b-instruct-q4_k_m.gguf             # smaller/faster, decent tool use
# MODEL_FILE=microsoft_Phi-4-mini-instruct-Q4_K_M.gguf     # small, 128K context, decent tool use
